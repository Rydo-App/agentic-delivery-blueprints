# The formatting rules of this repository. Every text file is written in UTF-8,
# with line feeds, with a final newline, without tabs and without trailing
# whitespace. The two checkers in scripts/ enforce the parts that can be
# checked, and the reviewer enforces the rest.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
indent_size = 2
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.mjs]
indent_size = 2

[*.json]
indent_size = 2
